#!/usr/bin/env bash
# mdview: MarkdownをpandocでHTMLに変換し、専用のChromeで開く。
# Chromeのウィンドウを閉じると、変換したHTMLと一時プロファイルを削除する。
# 表示中に元のファイルを書き換えると、裏でHTMLを作り直すので、
# Chromeでリロード (F5) すれば最新の内容になる。
#
# 使い方: mdview README.md
# 必要: pandoc (sudo dnf install pandoc)、google-chrome
set -euo pipefail

if [ $# -ne 1 ]; then
  echo "使い方: mdview FILE.md" >&2
  exit 1
fi
if ! command -v pandoc >/dev/null; then
  echo "pandocがありません: sudo dnf install pandoc" >&2
  exit 1
fi
if ! command -v google-chrome >/dev/null; then
  echo "google-chromeがありません" >&2
  exit 1
fi

src=$(realpath "$1")
tmp=$(mktemp -d)
watcher=""
trap '[ -n "$watcher" ] && kill "$watcher" 2>/dev/null; rm -rf "$tmp"' EXIT

# <base> で、元のファイルからの相対リンクや画像を解決する
cat > "$tmp/head.html" <<EOF
<base href="file://$(dirname "$src")/">
<style>
  :root { color-scheme: light dark; }
  body { max-width: 860px; margin: 2em auto; padding: 0 16px; line-height: 1.7;
         font-family: system-ui, "Noto Sans CJK JP", sans-serif; }
  pre, code { font-family: ui-monospace, "Noto Sans Mono CJK JP", monospace; }
  pre { padding: 12px; overflow-x: auto; background: rgba(127,127,127,.15); border-radius: 6px; }
  code { background: rgba(127,127,127,.15); padding: 0 .25em; border-radius: 3px; }
  pre code { background: none; padding: 0; }
  table { border-collapse: collapse; }
  th, td { border: 1px solid rgba(127,127,127,.5); padding: 4px 10px; }
  img { max-width: 100%; }
  div.mermaid { margin: 1em 0; }
</style>
<!-- Mermaid: pandoc は mermaid のコードブロックを pre.mermaid に変換するので、
     中のテキストを取り出して図に描き直す。CDN から読み込むためネット接続が必要。 -->
<script src="https://cdn.jsdelivr.net/npm/mermaid@10.9.1/dist/mermaid.min.js"></script>
<script>
  document.addEventListener("DOMContentLoaded", function () {
    document.querySelectorAll("pre.mermaid").forEach(function (pre) {
      var div = document.createElement("div");
      div.className = "mermaid";
      div.textContent = pre.textContent;
      pre.replaceWith(div);
    });
    if (window.mermaid) {
      var dark = window.matchMedia("(prefers-color-scheme: dark)").matches;
      mermaid.initialize({ startOnLoad: false, theme: dark ? "dark" : "default" });
      mermaid.run({ querySelector: "div.mermaid" });
    }
  });
</script>
EOF

# HTMLに変換する。書きかけのHTMLを読まれないよう、別名で作ってから置き換える。
render() {
  pandoc -f gfm -t html5 -s \
    --metadata pagetitle="$(basename "$src")" \
    -H "$tmp/head.html" "$src" -o "$tmp/view.html.new" &&
    mv -f "$tmp/view.html.new" "$tmp/view.html"
}
render

# 元のファイルを1秒ごとに見張り、更新時刻が変わったら作り直す
(
  last=$(stat -c %y "$src")
  while sleep 1; do
    now=$(stat -c %y "$src" 2>/dev/null) || continue
    if [ "$now" != "$last" ]; then
      last=$now
      render 2>/dev/null || true
    fi
  done
) &
watcher=$!

# 専用のプロファイルで起動すると、既存のChromeに引き継がれず、
# このウィンドウを閉じるまでコマンドが終了しない。
google-chrome \
  --user-data-dir="$tmp/profile" \
  --no-first-run --no-default-browser-check \
  --new-window "file://$tmp/view.html" >/dev/null 2>&1
